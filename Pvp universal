-- ESP — Sistema com sincronização imediata
-- ═══════════════════════════════════════════════════════════════
local HL_TAG = "AKZ_ESP_HL"
local BB_TAG = "AKZ_ESP_BB"

local function limparESP(player)
    local char = player.Character
    if not char then return end
    local hl = char:FindFirstChild(HL_TAG); if hl then hl:Destroy() end
    local bb = char:FindFirstChild(BB_TAG); if bb then bb:Destroy() end
end

local function limparTudoESP()
    for _, p in ipairs(Players:GetPlayers()) do limparESP(p) end
end

-- Essa função SEMPRE:
--   • cria o que deveria existir e não existe
--   • destrói o que existe e não deveria
--   • atualiza o que existe
-- Roda a cada frame e no callback de cada toggle
local function sincronizarESP(player)
    if player == LocalPlayer then return end

    local char = player.Character
    if not char then limparESP(player); return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then limparESP(player); return end

    -- Condições globais que forçam limpeza total
    if not Config.ESPEnabled then limparESP(player); return end
    if Config.ESPTeamCheck and GameAPI.hasTeams and isAlly(player) then
        limparESP(player); return
    end

    local color
    if Config.ESP_Color then color = getPlayerColor(player)
    else color = Color3.fromRGB(220,40,40) end

    -- ───────────── HIGHLIGHT ─────────────
    local hl = char:FindFirstChild(HL_TAG)
    if Config.ESP_Highlight then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = HL_TAG
            hl.Adornee = char
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
        end
        hl.FillColor = color
        hl.OutlineColor = Color3.fromRGB(255,255,255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
    elseif hl then
        hl:Destroy()
    end

    -- ───────────── NOME / DISTÂNCIA ─────────────
    local bb = char:FindFirstChild(BB_TAG)
    local querBB = Config.ESP_Name or Config.ESP_Distance

    if querBB then
        local head = char:FindFirstChild("Head")
        if head then
            if not bb then
                bb = Instance.new("BillboardGui")
                bb.Name = BB_TAG
                bb.Size = UDim2.new(0, 200, 0, 24)
                bb.StudsOffset = Vector3.new(0, 2.8, 0)
                bb.AlwaysOnTop = true
                bb.ResetOnSpawn = false
                bb.Adornee = head
                bb.Parent = head
                local lbl = Instance.new("TextLabel")
                lbl.Name = "Lbl"
                lbl.Size = UDim2.new(1,0,1,0)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 13
                lbl.TextStrokeTransparency = 0
                lbl.TextStrokeColor3 = Color3.new(0,0,0)
                lbl.Parent = bb
            end
            local txt = ""
            if Config.ESP_Name then txt = player.DisplayName end
            if Config.ESP_Distance then
                local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                txt = (txt ~= "") and (txt .. "  |  " .. dist .. "m") or (dist .. "m")
            end
            bb.Lbl.Text = txt
            bb.Lbl.TextColor3 = color
        end
    elseif bb then
        -- Não quer mais BB? Destrói imediatamente
        bb:Destroy()
    end
end

local function sincronizarTodosESP()
    for _, p in ipairs(Players:GetPlayers()) do
        sincronizarESP(p)
    end
end

