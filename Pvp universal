RunService.RenderStepped:Connect(function(dt)
    -- FOV
    local showFov = Config.AimbotEnabled and Config.AimbotShowFOV
    if showFov then
        fovCircle.Visible = true
        local centro = getScreenCenter()
        fovCircle.Position = UDim2.fromOffset(centro.X, centro.Y)
    else
        fovCircle.Visible = false
    end

    -- ESP — sincroniza TODOS a cada frame (garante estado correto)
    sincronizarTodosESP()

    -- Aimbot
    if Config.AimbotEnabled then
        local target = getAimbotTarget()
        if target then lockOn(target) end
    else
        Config.LockedTarget = nil
    end

    -- Movimento
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if Config.SpeedEnabled then hum.WalkSpeed = Config.SpeedValue end
            if Config.JumpEnabled then
                hum.UseJumpPower = true
                hum.JumpPower = Config.JumpValue
            end
        end
    end

    -- Armas
    weaponTick = weaponTick + dt
    if weaponTick >= 0.2 then
        weaponTick = 0
        if Config.NoRecoil or Config.NoSpread then applyWeaponMods() end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    limparESP(p)
    if Config.LockedTarget and Config.LockedTarget.Parent == p.Character then
        Config.LockedTarget = nil
    end
end)

