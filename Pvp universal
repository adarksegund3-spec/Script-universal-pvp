local GameAPI = { detected=false, method=nil, hasTeams=false, teamsFound=0, playersCount=0 }

local GENERIC_TEAM_NAMES = {
    ["play"]=true, ["players"]=true, ["player"]=true, ["lobby"]=true,
    ["neutral"]=true, ["default"]=true, ["none"]=true, ["nil"]=true,
    ["all"]=true, ["everyone"]=true, ["global"]=true, ["free"]=true,
    ["freed"]=true, ["in game"]=true, ["ingame"]=true, ["spectator"]=true,
    ["spectate"]=true, ["waiting"]=true, ["dead"]=true, ["alive"]=true,
    ["other"]=true, ["white"]=true, ["ghost"]=true,
}

local function isGenericTeamName(name)
    if not name then return true end
    local n = tostring(name):lower():gsub("^%s+",""):gsub("%s+$","")
    if n == "" then return true end
    return GENERIC_TEAM_NAMES[n] == true
end

local function getTeamViaTeam(p)
    if not p then return nil end
    local ok, t = pcall(function() return p.Team end)
    if ok and t then return t end
    return nil
end

local function getTeamViaAttribute(p)
    if not p then return nil end
    local c = p.Character; if not c then return nil end
    local ok, v = pcall(function() return c:GetAttribute("TeamColor") end)
    if ok and v then return tostring(v) end
    return nil
end

local function getTeamViaStringValue(p)
    if not p then return nil end
    local c = p.Character; if not c then return nil end
    local sv = c:FindFirstChild("Team")
    if sv and (sv:IsA("StringValue") or sv:IsA("ObjectValue")) then return sv.Value end
    return nil
end

local function getRawTeamKey(p, method)
    if method == "Team" then
        local t = getTeamViaTeam(p); if t then return tostring(t) end
    elseif method == "Attribute" then
        return getTeamViaAttribute(p)
    elseif method == "StringValue" then
        local v = getTeamViaStringValue(p); if v then return tostring(v) end
    end
    return nil
end

local function getPlayerTeam(p)
    if not p then return nil end
    if GameAPI.method == "Team" then
        local t = getTeamViaTeam(p); if t then return t end
    elseif GameAPI.method == "Attribute" then
        local s = getTeamViaAttribute(p); if s then return s end
    elseif GameAPI.method == "StringValue" then
        local v = getTeamViaStringValue(p); if v then return v end
    end
    return nil
end

local function isAlly(p)
    if not p or p == LocalPlayer then return false end
    if not GameAPI.hasTeams then return false end
    local mine = getPlayerTeam(LocalPlayer)
    local their = getPlayerTeam(p)
    if mine == nil or their == nil then return false end
    return tostring(mine) == tostring(their)
end

local function parseRGB(s)
    if not s then return nil end
    local r, g, b = tostring(s):match("([%d%.]+),%s*([%d%.]+),%s*([%d%.]+)")
    if r and g and b then return Color3.new(tonumber(r) or 1, tonumber(g) or 1, tonumber(b) or 1) end
    return nil
end

local function getTeamColorFor(p)
    local s = getTeamViaAttribute(p)
    local cor = parseRGB(s); if cor then return cor end
    local t = getTeamViaTeam(p)
    if t then
        local ok, tc = pcall(function() return t.TeamColor end)
        if ok and tc and tc.Color then return tc.Color end
    end
    local ok, tc = pcall(function() return p.TeamColor end)
    if ok and tc and tc.Color then return tc.Color end
    return nil
end

local function getPlayerColor(p)
    if p == LocalPlayer then return Color3.fromRGB(120,220,140) end
    if GameAPI.hasTeams and isAlly(p) then return Color3.fromRGB(80,170,255) end
    local c = getTeamColorFor(p); if c then return c end
    return Color3.fromRGB(220,40,40)
end

local function detectGameAPI()
    GameAPI.detected = false
    GameAPI.method = nil
    GameAPI.hasTeams = false
    GameAPI.teamsFound = 0

    local allPlayers = Players:GetPlayers()
    GameAPI.playersCount = #allPlayers

    if GameAPI.playersCount < 2 then
        GameAPI.detected = true
        return true, "Poucos players • todos são alvo"
    end

    local function analyzeMethod(methodName)
        local teamMap = {}
        for _, p in ipairs(allPlayers) do
            local key = getRawTeamKey(p, methodName)
            if key then
                teamMap[key] = teamMap[key] or { count = 0 }
                teamMap[key].count = teamMap[key].count + 1
            end
        end
        local valid = {}
        for key, data in pairs(teamMap) do
            if not isGenericTeamName(key) and data.count < #allPlayers and data.count >= 1 then
                valid[key] = data
            end
        end
        local count = 0
        for _ in pairs(valid) do count = count + 1 end
        return { validTeams = count }
    end

    local teamA = analyzeMethod("Team")
    local attrA = analyzeMethod("Attribute")
    local svA   = analyzeMethod("StringValue")

    local chosen = nil
    local analysis = nil
    if teamA.validTeams >= 2 then chosen = "Team"; analysis = teamA
    elseif attrA.validTeams >= 2 then chosen = "Attribute"; analysis = attrA
    elseif svA.validTeams >= 2 then chosen = "StringValue"; analysis = svA end

    if chosen then
        GameAPI.method = chosen
        GameAPI.hasTeams = true
        GameAPI.teamsFound = analysis.validTeams
    end

    GameAPI.detected = true
    if GameAPI.hasTeams then
        return true, "API Detectada • " .. GameAPI.teamsFound .. " times"
    else
        return true, "API Detectada • Sem times • todos são alvo"
    end
end

